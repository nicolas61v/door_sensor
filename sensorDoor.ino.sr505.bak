// Sensor de puerta + PIR (SR505) para ESP32
//
// Logica:
// - Puerta cerrada -> se abre/reinicia una ventana de VENTANA_DETECCION_MS (30s)
//   en la que el PIR debe marcar movimiento CONTINUO por al menos
//   UMBRAL_MOVIMIENTO_MS (5s) para confirmarlo (evita falsos positivos cortos,
//   ej. un insecto).
// - Si se confirma movimiento dentro de esos 30s, la salida se activa/mantiene
//   en ON y el sistema deja de sensar hasta el proximo cierre de puerta.
// - Si NO se confirma movimiento en los 30s, la salida se pone/queda en OFF y
//   la ventana se reinicia sola (sigue sensando sin parar mientras la puerta
//   siga cerrada, no solo una vez al cerrar).
// - Abrir la puerta nunca afecta nada por si sola (ni cancela la ventana, ni
//   apaga la salida): la salida se queda como estaba.
// - Cerrar la puerta SIEMPRE reactiva el sensado del PIR, sin importar el
//   estado previo (incluso si ya estaba DISPARADO). Es el resultado de esa
//   nueva ventana el que decide si la salida se queda en ON o pasa a OFF.
// - Respaldo de seguridad: si la puerta queda ABIERTA de forma continua por
//   DOOR_OPEN_RESET_MS (5 minutos) estando DISPARADO, se apaga sola y el
//   sistema vuelve a quedar en espera (por si nadie vuelve a cerrar la puerta).

#include <Arduino.h>

// --- Pines (ajustar segun el cableado real) ---
const uint8_t PIN_DOOR_SWITCH = 14;  // Switch de puerta: INPUT_PULLUP, LOW = puerta cerrada
const uint8_t PIN_PIR         = 27;  // Salida digital del SR505: HIGH = movimiento
const uint8_t PIN_OUTPUT      = 2;  // Salida hacia rele/buzzer/LED de alarma

// --- Parametros ---
const unsigned long VENTANA_DETECCION_MS = 30000;  // 30s de vigilancia tras cerrar la puerta
const unsigned long UMBRAL_MOVIMIENTO_MS = 5000;   // el PIR debe estar en HIGH continuo este tiempo para confirmar
const unsigned long DOOR_OPEN_RESET_MS   = 300000; // 5 minutos de puerta abierta seguida -> apaga y resetea
const unsigned long DEBOUNCE_MS          = 50;     // antirrebote del switch mecanico
const unsigned long LOG_PERIODO_MS       = 1000;   // frecuencia del log de estado por consola

// --- Estados del sistema ---
enum EstadoSistema {
  IDLE,       // esperando: puerta abierta, o cerrada pero aun sin armar ventana
  ARMADO,     // puerta cerrada, contando confirmacion de movimiento dentro de la ventana
  DISPARADO   // movimiento confirmado, salida fija en ON hasta el reset por puerta abierta
};

EstadoSistema estado = IDLE;

bool puertaCerradaEstable = false;   // estado logico (con antirrebote) del switch
bool ultimaLecturaSwitch  = false;   // ultima lectura cruda leida
unsigned long tUltimoCambioSwitch = 0;

unsigned long tInicioArmado = 0;
unsigned long tPuertaAbiertaDesde = 0; // momento en que la puerta paso a ABIERTA
unsigned long tUltimoLog = 0;

bool pirEstadoAnterior = false;
unsigned long tPirActivoDesde = 0;   // momento en que el PIR paso a HIGH sin interrupcion

const char* nombreEstado(EstadoSistema e) {
  switch (e) {
    case IDLE:      return "IDLE";
    case ARMADO:    return "ARMADO";
    case DISPARADO: return "DISPARADO";
  }
  return "?";
}

void setup() {
  Serial.begin(115200);

  pinMode(PIN_DOOR_SWITCH, INPUT_PULLUP);
  pinMode(PIN_PIR, INPUT_PULLDOWN); // si el pin queda flotando, por defecto lee LOW (sin movimiento)
  pinMode(PIN_OUTPUT, OUTPUT);
  digitalWrite(PIN_OUTPUT, LOW);

  // Inicializa el estado del switch con la lectura actual para evitar un
  // falso flanco al arrancar
  ultimaLecturaSwitch = (digitalRead(PIN_DOOR_SWITCH) == LOW);
  puertaCerradaEstable = ultimaLecturaSwitch;
  if (!puertaCerradaEstable) {
    tPuertaAbiertaDesde = millis();
  } else {
    // Arranca con la puerta ya cerrada: arma de una vez.
    estado = ARMADO;
    tInicioArmado = millis();
  }

  Serial.println("Sistema listo.");
}

// Devuelve true si hubo un cambio de estado estable del switch (con antirrebote)
bool actualizarSwitchPuerta() {
  bool lecturaActual = (digitalRead(PIN_DOOR_SWITCH) == LOW); // LOW = cerrada

  if (lecturaActual != ultimaLecturaSwitch) {
    tUltimoCambioSwitch = millis();
    ultimaLecturaSwitch = lecturaActual;
  }

  if ((millis() - tUltimoCambioSwitch) > DEBOUNCE_MS &&
      lecturaActual != puertaCerradaEstable) {
    puertaCerradaEstable = lecturaActual;
    return true; // cambio de estado confirmado
  }

  return false;
}

void loop() {
  bool huboCambioPuerta = actualizarSwitchPuerta();

  if (huboCambioPuerta) {
    if (puertaCerradaEstable) {
      // Cerrar la puerta SIEMPRE reactiva el sensado del PIR, sin importar el
      // estado previo. La salida NO se toca aqui directamente: la decide el
      // resultado de esta nueva ventana (ver bloque ARMADO mas abajo).
      estado = ARMADO;
      tInicioArmado = millis();
      pirEstadoAnterior = false;
      tPirActivoDesde = 0;
      Serial.println("Puerta cerrada. Reactivando sensado del PIR (30s)...");
    } else {
      // Abrir la puerta NO afecta el sensado ni la salida en ningun estado:
      // si estaba ARMADO, sigue contando igual; si estaba DISPARADO, sigue en ON.
      // Solo importan el cierre de puerta (arriba) o los DOOR_OPEN_RESET_MS
      // de puerta abierta seguida como respaldo (ver abajo).
      Serial.println("Puerta abierta.");
      tPuertaAbiertaDesde = millis();
    }
  }

  if (estado == ARMADO) {
    bool pirRaw = (digitalRead(PIN_PIR) == HIGH);

    if (pirRaw) {
      if (!pirEstadoAnterior) {
        tPirActivoDesde = millis(); // el PIR acaba de pasar a HIGH, empieza a contar
      }
      if (millis() - tPirActivoDesde >= UMBRAL_MOVIMIENTO_MS) {
        estado = DISPARADO;
        digitalWrite(PIN_OUTPUT, HIGH);
        Serial.println("Movimiento confirmado (>=5s continuos). Salida activada y fija en ON.");
      }
    } else {
      tPirActivoDesde = 0; // se corto la señal antes de confirmar: se descarta (posible falso positivo)
    }
    pirEstadoAnterior = pirRaw;

    if (estado == ARMADO && millis() - tInicioArmado >= VENTANA_DETECCION_MS) {
      // No se confirmo movimiento en esta ventana: si la salida venia encendida
      // de un ciclo anterior, se apaga aqui. La puerta sigue cerrada, asi que
      // se reinicia la ventana para seguir sensando sin parar.
      digitalWrite(PIN_OUTPUT, LOW);
      tInicioArmado = millis();
      pirEstadoAnterior = false;
      tPirActivoDesde = 0;
      Serial.println("Ventana de 30s cumplida sin movimiento. Salida en OFF. Puerta sigue cerrada: reiniciando ventana.");
    }
  } else if (estado == DISPARADO) {
    // Unica salida de este estado: puerta abierta de forma continua 5 minutos.
    if (!puertaCerradaEstable && (millis() - tPuertaAbiertaDesde >= DOOR_OPEN_RESET_MS)) {
      digitalWrite(PIN_OUTPUT, LOW);
      estado = IDLE;
      Serial.println("Puerta abierta 5 minutos seguidos. Alarma apagada. Sistema en espera.");
    }
  }

  // --- Log periodico de estado, para ver en vivo por el Monitor Serie ---
  if (millis() - tUltimoLog >= LOG_PERIODO_MS) {
    tUltimoLog = millis();

    Serial.print("[t=");
    Serial.print(millis() / 1000);
    Serial.print("s] estado=");
    Serial.print(nombreEstado(estado));
    Serial.print(" | puerta=");
    Serial.print(puertaCerradaEstable ? "CERRADA" : "ABIERTA");
    Serial.print(" | pir_raw=");
    Serial.print(digitalRead(PIN_PIR) == HIGH ? "MOVIMIENTO" : "quieto");
    Serial.print(" | salida=");
    Serial.print(digitalRead(PIN_OUTPUT) == HIGH ? "ON" : "off");

    if (estado == ARMADO) {
      long restanteMs = (long)VENTANA_DETECCION_MS - (long)(millis() - tInicioArmado);
      if (restanteMs < 0) restanteMs = 0;
      Serial.print(" | ventana_restante=");
      Serial.print(restanteMs / 1000);
      Serial.print("s");

      if (pirEstadoAnterior) {
        long confirmadoMs = (long)(millis() - tPirActivoDesde);
        if (confirmadoMs < 0) confirmadoMs = 0;
        Serial.print(" | confirmando_movimiento=");
        Serial.print(confirmadoMs / 1000.0, 1);
        Serial.print("s/");
        Serial.print(UMBRAL_MOVIMIENTO_MS / 1000);
        Serial.print("s");
      }
    } else if (estado == DISPARADO && !puertaCerradaEstable) {
      long abiertaMs = (long)(millis() - tPuertaAbiertaDesde);
      long faltaMs = (long)DOOR_OPEN_RESET_MS - abiertaMs;
      if (faltaMs < 0) faltaMs = 0;
      Serial.print(" | puerta_abierta_hace=");
      Serial.print(abiertaMs / 1000);
      Serial.print("s | se_apaga_en=");
      Serial.print(faltaMs / 1000);
      Serial.print("s");
    }

    Serial.println();
  }
}
